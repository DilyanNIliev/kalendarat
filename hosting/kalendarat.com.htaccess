# kalendarat.com – Apache / LiteSpeed
# ВАЖНО: пуснете SSL сертификата за домейна, преди да качите този файл.

# 0) Пренасочване от адреса на поддомейна (същото като в cPanel → Redirects)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^kalendarat\.com\.dilyanilievdesign\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.kalendarat\.com\.dilyanilievdesign\.com$
RewriteRule ^(.*)$ "https://kalendarat.com/$1" [R=301,L]

# 1) Винаги https и само на kalendarat.com (без www и без други адреси/поддомейни, сочещи към тази папка)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^kalendarat\.com$ [NC]
RewriteRule ^ https://kalendarat.com%{REQUEST_URI} [L,R=301]

# Текстовите файлове (robots.txt, llms.txt) да са в UTF-8
AddDefaultCharset UTF-8

# 2) Страница за липсващи адреси
ErrorDocument 404 /404.html

# 3) Папките се отварят с index.html; SVG иконите да се обслужват с правилния тип
DirectoryIndex index.html
AddType image/svg+xml .svg .svgz

# 4) Сигурност: браузърът да ползва само https (6 месеца)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5) Компресия
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# 6) Кеширане: css и js са с версия в адреса, затова може за дълго; страниците – за кратко
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>
